local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local Workspace    = game:GetService("Workspace")
local VirtualUser  = game:GetService("VirtualUser")
local TweenService = game:GetService("TweenService")
local UserInput    = game:GetService("UserInputService")
local StarterGui   = game:GetService("StarterGui")

local LP = Players.LocalPlayer

-- ================== СОСТОЯНИЯ (ВКЛ/ВЫКЛ) ==================
local State = {
    AutoFarmLevel = false,   -- по умолчанию ВЫКЛ
    AutoFarmCandy = false,   -- по умолчанию ВЫКЛ
    AutoHaki      = true,
    AttackDistance = 30,
}

-- ================== ХЕЛПЕРЫ ==================
local function notify(msg)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "BF Farm", Text = msg, Duration = 3
        })
    end)
    print("[BF]", msg)
end

local function getChar() return LP.Character or LP.CharacterAdded:Wait() end
local function getHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function isAlive()
    local c = LP.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function tweenTo(pos, speed)
    local hrp = getHRP(); if not hrp then return end
    speed = speed or 70
    local dist = (pos - hrp.Position).Magnitude
    local info = TweenInfo.new(dist / speed, Enum.EasingStyle.Linear)
    local tw = TweenService:Create(hrp, info, {CFrame = CFrame.new(pos)})
    tw:Play()
    tw.Completed:Wait()
end
local function attackTool()
    local char = LP.Character
    if not char then return end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then pcall(function() t:Activate() end) end
    end
end

-- Анти-АФК
LP.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

-- Авто Haki (постоянно)
task.spawn(function()
    while task.wait(1) do
        if not State.AutoHaki or not isAlive() then continue end
        pcall(function()
            for _, name in ipairs({"Haki", "Buso Haki", "Ken Haki", "Observation"}) do
                local t = LP.Backpack:FindFirstChild(name) or LP.Character:FindFirstChild(name)
                if t and t:IsA("Tool") then
                    LP.Character.Humanoid:EquipTool(t)
                    t:Activate()
                end
            end
        end)
    end
end)

-- ============================================================
--  ФУНКЦИЯ 1: АВТО ФАРМ УРОВНЯ (вкл/выкл через State.AutoFarmLevel)
-- ============================================================
local function getNearestEnemy()
    local hrp = getHRP(); if not hrp then return nil end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hum  = obj:FindFirstChildOfClass("Humanoid")
            local root = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
            if hum and root and hum.Health > 0
                and not Players:GetPlayerFromCharacter(obj)
                and obj.Name ~= LP.Name then
                local d = (root.Position - hrp.Position).Magnitude
                if d < bestDist and d < 300 then
                    best, bestDist = obj, d
                end
            end
        end
    end
    return best
end

local function farmLevelTick()
    if not State.AutoFarmLevel then return end
    if not isAlive() then return end
    local enemy = getNearestEnemy()
    if not enemy then return end

    local root = enemy:FindFirstChild("HumanoidRootPart") or enemy.PrimaryPart
    local hum  = enemy:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local hrp = getHRP(); if not hrp then return end
    if (root.Position - hrp.Position).Magnitude > State.AttackDistance then
        tweenTo(root.Position + Vector3.new(0, 5, 0), 90)
    end
    attackTool()
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        vim:SendKeyEvent(true, "E", false, game)
        vim:SendKeyEvent(false, "E", false, game)
    end)
end

-- ============================================================
--  ФУНКЦИЯ 2: АВТО ФАРМ КОНФЕТ (вкл/выкл через State.AutoFarmCandy)
-- ============================================================
local function findCandy()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("MeshPart") then
            local n = obj.Name:lower()
            if n:find("candy") or n:find("candie") or n:find("sweet") then
                return obj
            end
        end
    end
    return nil
end

local function farmCandyTick()
    if not State.AutoFarmCandy then return end
    if not isAlive() then return end
    local candy = findCandy()
    if not candy then return end

    local part = candy:IsA("Model")
        and (candy.PrimaryPart or candy:FindFirstChild("HumanoidRootPart") or candy:FindFirstChildWhichIsA("BasePart"))
        or candy
    if not part or not part.Position then return end

    local hrp = getHRP(); if not hrp then return end
    if (part.Position - hrp.Position).Magnitude > State.AttackDistance then
        tweenTo(part.Position + Vector3.new(0, 5, 0), 80)
    end
    attackTool()
end

-- ============================================================
--  ГЛАВНЫЙ ЦИКЛ (вызывает tick-функции, только если включены)
-- ============================================================
task.spawn(function()
    while task.wait(0.3) do
        pcall(farmLevelTick)
        pcall(farmCandyTick)
    end
end)

