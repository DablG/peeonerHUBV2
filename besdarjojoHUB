local function makeToggle(text, yPos, key, hotkey)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    btn.Text = string.format("%s: %s", text, State[key] and "ВКЛ" or "ВЫКЛ")
    btn.TextColor3 = Color3.white
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local function refresh()
        btn.Text = string.format("%s: %s  [%s]", text, State[key] and "ВКЛ" or "ВЫКЛ", hotkey)
        btn.BackgroundColor3 = State[key]
            and Color3.fromRGB(60, 160, 60)
            or Color3.fromRGB(60, 60, 70)
    end

    btn.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        refresh()
        notify(text .. (State[key] and " ВКЛ" or " ВЫКЛ"))
    end)
    refresh()

    UserInput.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode[hotkey] then
            State[key] = not State[key]
            refresh()
            notify(text .. (State[key] and " ВКЛ" or " ВЫКЛ"))
        end
    end)
end

