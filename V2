-- ============================================
-- ОСНОВНОЙ ЦИКЛ
-- ============================================
local function MainLoop()
    while Enabled do
        wait(Config.ScanInterval)
        
        if IsHopping then
            Status.Text = "Хопаем..."
            continue
        end
        
        local fruit = FindFruit()
        
        if fruit then
            Status.Text = "Найден: " .. fruit.Name
            print("[SWILL] Найден фрукт: " .. fruit.Name)
            
            local success = TeleportToFruit(fruit)
            
            if success then
                wait(0.5)
                CollectFruit(fruit)
                Status.Text = "Собрал: " .. fruit.Name
                print("[SWILL] Собрал: " .. fruit.Name)
                wait(1)
            end
        else
            Status.Text = "Фруктов нет, хопаем..."
            print("[SWILL] Фруктов нет на сервере")
            
            if Config.AutoHop then
                wait(Config.HopRetryDelay)
                spawn(InfiniteServerHop)
            end
        end
    end
end

