-- SWILL FRUIT FARMER (Delta)
-- Авто-сбор фруктов + Server Hop + Anti-AFK

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId

-- НАСТРОЙКИ
local Config = {
    ScanInterval = 2,        -- Как часто сканировать фрукты (сек)
    HopDelay = 5,            -- Задержка перед хопом (сек)
    MaxServerPlayers = 8,    -- Макс игроков в сервере для хопа
    TweenSpeed = 300,        -- Скорость полёта
    AntiAFK = true,
    AutoHop = true
}

local Enabled = true
local VisitedServers = {}
local IsHopping = false

-- ============================================
-- ПОИСК ФРУКТОВ
-- ============================================
local function FindFruit()
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Tool") or v:IsA("Model") then
            local name = v.Name:lower()
            if name:find("fruit") or name:find("dragon") or name:find("dough") or name:find("leopard") or name:find("kitsune") then
                return v
            end
        end
    end
    return nil
end

-- ============================================
-- ТЕЛЕПОРТ К ФРУКТУ
-- ============================================
local function TeleportToFruit(fruit)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local fruitPart = fruit:FindFirstChildWhichIsA("BasePart")
    if not fruitPart and fruit:IsA("Tool") then
        fruitPart = fruit:FindFirstChild("Handle")
    end
    
    if not fruitPart then return false end
    
    -- Плавный полёт к фрукту
    local targetPos = fruitPart.CFrame
    local distance = (hrp.Position - fruitPart.Position).Magnitude
    
    if distance > 500 then
        -- Далеко — телепорт
        hrp.CFrame = targetPos * CFrame.new(0, 5, 0)
    else
        -- Близко — плавный полёт
        local tweenInfo = TweenInfo.new(distance / Config.TweenSpeed, Enum.EasingStyle.Linear)
        local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetPos * CFrame.new(0, 5, 0)})
        tween:Play()
        tween.Completed:Wait()
    end
    
    wait(0.3)
    return true
end

-- ============================================
-- СБОР ФРУКТА (клик + попытка взять)
-- ============================================
local function CollectFruit(fruit)
    local VirtualInput = game:GetService("VirtualInputManager")
    
    -- Клик по фрукту (левая кнопка)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
    wait(0.1)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
    
    wait(0.2)
    -- Нажимаем E для взаимодействия
    VirtualInput:SendKeyEvent(true, "E", false, nil)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "E", false, nil)
    
    wait(0.3)
end

-- ============================================
-- SERVER HOP
-- ============================================
local function ServerHop()
    if IsHopping then return end
    IsHopping = true
    
    print("[SWILL] Хопаем сервер...")
    
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if not success or not response or not response.data then
        print("[SWILL] Не удалось получить список серверов")
        IsHopping = false
        return
    end
    
    local servers = {}
    for _, server in ipairs(response.data) do
        if server.id ~= game.JobId 
           and server.playing < Config.MaxServerPlayers 
           and server.playing > 0
           and not VisitedServers[server.id] then
            table.insert(servers, server)
        end
    end
    
    if #servers == 0 then
        print("[SWILL] Нет доступных серверов, пробуем сбросить список")
        VisitedServers = {}
        wait(2)
        IsHopping = false
        return
    end
    
    -- Выбираем случайный сервер
    local chosenServer = servers[math.random(1, #servers)]
    VisitedServers[chosenServer.id] = true
    
    print("[SWILL] Телепорт на сервер: " .. chosenServer.id .. " | Игроков: " .. chosenServer.playing)
    
    TeleportService:TeleportToPlaceInstance(PlaceId, chosenServer.id, LocalPlayer)
end

