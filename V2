end

-- ============================================
-- ПИРАТЫ
-- ============================================
local function DoPirates()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v.Humanoid.Health > 0 then
                local name = v.Name:lower()
                if name:find("pirate") or name:find("marine") or name:find("enemy") or name:find("soldier") or name:find("guard") then
                    if not Players:GetPlayerFromCharacter(v) then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                            wait(0.1)
                            VirtualInput:SendKeyEvent(true, "Q", false, nil)
                            wait(0.05)
                            VirtualInput:SendKeyEvent(false, "Q", false, nil)
                            VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
                            wait(0.05)
                            VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- ============================================
-- SERVER HOP
-- ============================================
local function GetServers()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not success or not response or not response.data then return {} end
    local servers = {}
    for _, server in ipairs(response.data) do
        if server.id ~= game.JobId
           and server.playing < Config.MaxServerPlayers
           and server.playing > 0
           and not VisitedServers[server.id] then
            table.insert(servers, server)
        end
    end
    return servers
end

local function InfiniteHop()
    if IsHopping then return end
    IsHopping = true
    while Enabled do
        HopAttempts = HopAttempts + 1
        print("[SWILL] Хоп #" .. HopAttempts)
        local servers = GetServers()
        if #servers == 0 then
            VisitedServers = {}
            wait(Config.HopRetryDelay)
        else
            for i = #servers, 2, -1 do
                local j = math.random(i)
                servers[i], servers[j] = servers[j], servers[i]
            end
            for _, server in ipairs(servers) do
                if not Enabled then IsHopping = false return end
                VisitedServers[server.id] = true
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                end)
                wait(Config.HopRetryDelay)
            end
        end
        wait(Config.HopRetryDelay)
    end
    IsHopping = false
end

