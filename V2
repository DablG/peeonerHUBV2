-- SWILL AUTO FARM SUITE (Delta / Xeno)
-- Авто-сбор фруктов | Авто-гача | Авто-фабрика | Авто-пираты

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInput = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

-- НАСТРОЙКИ
local Config = {
    ScanInterval = 1.5,
    TweenSpeed = 300,
    AutoGacha = true,
    AutoFactory = true,
    AutoPirates = true
}

-- ФУНКЦИЯ ПОИСКА ФРУКТОВ
local function FindFruit()
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Tool") or v:IsA("Model") then
            local name = v.Name:lower()
            -- Ищем всё, что похоже на фрукт
            if name:find("fruit") or name:find("dragon") or name:find("dough") 
               or name:find("leopard") or name:find("kitsune") or name:find("venom")
               or name:find("shadow") or name:find("buddha") or name:find("portal") then
                return v
            end
        end
    end
    return nil
end

-- ТЕЛЕПОРТ И СБОР
local function CollectFruit(fruit)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local fruitPart = fruit:FindFirstChildWhichIsA("BasePart")
    if not fruitPart and fruit:IsA("Tool") then
        fruitPart = fruit:FindFirstChild("Handle")
    end
    if not fruitPart then return end

    -- Телепорт (плавно или сразу)
    local dist = (hrp.Position - fruitPart.Position).Magnitude
    if dist > 500 then
        hrp.CFrame = fruitPart.CFrame * CFrame.new(0, 5, 0)
    else
        local tween = TweenService:Create(hrp, TweenInfo.new(dist/Config.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = fruitPart.CFrame * CFrame.new(0, 5, 0)})
        tween:Play()
        tween.Completed:Wait()
    end

    wait(0.2)
    -- Сбор (клик + E)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
    wait(0.05)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
    wait(0.1)
    VirtualInput:SendKeyEvent(true, "E", false, nil)
    wait(0.05)
    VirtualInput:SendKeyEvent(false, "E", false, nil)
end

-- АВТО-ГАЧА (Покупка/Ролл)
local function DoGacha()
    -- Ищем NPC Гачи или кнопку
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") then
            local name = v.Name:lower()
            if name:find("gacha") or name:find("dealer") or name:find("blox fruit dealer") then
                local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                    wait(0.3)
                    -- Взаимодействие (E)
                    VirtualInput:SendKeyEvent(true, "E", false, nil)
                    wait(0.1)
                    VirtualInput:SendKeyEvent(false, "E", false, nil)
                    wait(2)
                    return true
                end
            end
        end
    end
    return false
end

-- АВТО-ФАБРИКА (Поиск и атака ядра)
local function DoFactory()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            local name = v.Name:lower()
            if name:find("core") or name:find("factory") or name:find("raid") then
                if v.Humanoid.Health > 0 then
                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, -5)
                        wait(0.1)
                        -- Атака (Q + Клик)
                        VirtualInput:SendKeyEvent(true, "Q", false, nil)
                        wait(0.05)
                        VirtualInput:SendKeyEvent(false, "Q", false, nil)
                        VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
                        wait(0.05)
                        VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
                        return true
                    end
                end
            end
        end
    end
    return false
end

-- АВТО-ПИРАТЫ (Атака врагов)
local function DoPirates()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") then
            if v.Humanoid.Health > 0 then
                local name = v.Name:lower()
                -- Ищем пиратов, морпехов или врагов
                if name:find("pirate") or name:find("marine") or name:find("enemy") or name:find("soldier") or name:find("guard") then
                    -- Проверка, что это не игрок
                    if not Players:GetPlayerFromCharacter(v) then
                        local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            hrp.CFrame = v.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
                            wait(0.1)
                            VirtualInput:SendKeyEvent(true, "Q", false, nil)
                            wait(0.05)
                            VirtualInput:SendKeyEvent(false, "Q", false, nil)
                            VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
                            wait(0.05)
                            VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

-- ОСНОВНОЙ ЦИКЛ
spawn(function()
    while wait(Config.ScanInterval) do
        local char = LocalPlayer.Character
        if not char then continue end
        
        -- 1. Сбор фруктов
        local fruit = FindFruit()
        if fruit then
            CollectFruit(fruit)
        end

        -- 2. Гача
        if Config.AutoGacha then
            DoGacha()
        end

        -- 3. Фабрика
        if Config.AutoFactory then
            DoFactory()
        end

        -- 4. Пираты
        if Config.AutoPirates then
            DoPirates()
        end
    end
end)

-- АНТИ-АФК
spawn(function()
    while wait(15) do
        pcall(function()
            game:GetService("VirtualUser"):CaptureController()
            game:GetService("VirtualUser"):ClickButton2(Vector2.new(0, 0))
        end)
    end
end)

print("SWILL SUITE | Фрукты + Гача + Фабрика + Пираты | ЗАПУЩЕН")
