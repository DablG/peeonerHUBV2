-- ОСНОВНОЙ ЦИКЛ
-- ============================================
local function MainLoop()
    while Enabled do
        wait(0.5)
        if IsHopping then
            Status.Text = "Хопаем..."
            continue
        end

        local elapsed = tick() - StartTime
        local remaining = math.max(0, Config.FarmTime - math.floor(elapsed))
        TimerLabel.Text = "До хопа: " .. remaining .. " сек"

        if elapsed >= Config.FarmTime then
            Status.Text = "Время вышло — хопаем!"
            StartTime = tick()
            spawn(InfiniteHop)
            continue
        end

        local char = LocalPlayer.Character
        if not char then continue end

        local anyActive = false

        -- 1. ФРУКТЫ
        if Toggles.Fruits then
            local fruit = FindFruit()
            if fruit then
                Status.Text = "Найден: " .. fruit.Name
                CollectFruit(fruit)
                Status.Text = "Собрал: " .. fruit.Name
                wait(0.5)
                anyActive = true
            end
        end

        -- 2. ГАЧА
        if Toggles.Gacha and not anyActive then
            if DoGacha() then
                Status.Text = "Гача..."
                anyActive = true
            end
        end

        -- 3. ФАБРИКА
        if Toggles.Factory and not anyActive then
            if DoFactory() then
                Status.Text = "Фабрика..."
                anyActive = true
            end
        end

        -- 4. ПИРАТЫ
        if Toggles.Pirates and not anyActive then
            if DoPirates() then
                Status.Text = "Пираты..."
                anyActive = true
            end
        end

        -- 5. АВТО ХАКИ (работает в фоне)
        if Toggles.Haki then
            local now = tick()
            if now - LastHakiCheck >= Config.HakiCheckInterval then
                UseHaki()
                LastHakiCheck = now
            end
        end

        -- 6. СТИЛЬ БОЯ (работает в фоне)
        if Toggles.Style then
            local now = tick()
            if now - LastStyleCheck >= Config.StyleCheckInterval then
                SelectFightingStyle()
                LastStyleCheck = now
            end
        end

        if not anyActive then
            Status.Text = "Поиск..."
            wait(Config.ScanInterval)
        end
    end
end

