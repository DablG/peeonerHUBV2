-- ============================================
-- АВТО ХАКИ (Buso / Ken)
-- ============================================
local function UseHaki()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    -- Проверяем, есть ли у персонажа способности хаки
    -- Buso Haki (Armament)
    local buso = char:FindFirstChild("Buso") or char:FindFirstChild("Armament")
    if buso then
        pcall(function()
            buso:Activate()
        end)
    end
    
    -- Ken Haki (Observation)
    local ken = char:FindFirstChild("Ken") or char:FindFirstChild("Observation")
    if ken then
        pcall(function()
            ken:Activate()
        end)
    end
    
    -- Альтернативный способ через клавиши (если есть)
    -- Buso обычно на клавише Z, Ken на X (зависит от настроек)
    -- Но это может конфликтовать с другими функциями, поэтому используем проверку объектов
    
    return true
end

-- ============================================
-- АВТО ВЫБОР СТИЛЯ БОЯ
-- ============================================
local function SelectFightingStyle()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    
    -- Ищем доступные стили боя в Backpack или Character
    local styles = {
        "Godhuman", "Sanguine Art", "Dragon Talon", "Electric Claw",
        "Sharkman Karate", "Death Step", "Superhuman", "Dragon Claw",
        "Fishman Karate", "Black Leg", "Electro"
    }
    
    -- Проверяем, что уже экипировано
    local currentTool = char:FindFirstChildOfClass("Tool")
    local currentName = currentTool and currentTool.Name or ""
    
    -- Если стиль уже хороший, не меняем
    for _, styleName in ipairs(styles) do
        if currentName:find(styleName) then
            return true
        end
    end
    
    -- Ищем лучший доступный стиль
    for _, styleName in ipairs(styles) do
        -- Проверяем в Backpack
        for _, item in pairs(LocalPlayer.Backpack:GetChildren()) do
            if item.Name:find(styleName) then
                humanoid:EquipTool(item)
                return true
            end
        end
        -- Проверяем в Character
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") and item.Name:find(styleName) then
                -- Уже экипирован
                return true
            end
        end
    end
    
    return false
end

