-- SWILL FRUIT FARMER v2 (Delta)
-- Бесконечный Server Hop + Авто-сбор фруктов + Anti-AFK

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local VirtualUser = game:GetService("VirtualUser")
local VirtualInput = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer
local PlaceId = game.PlaceId

-- НАСТРОЙКИ
local Config = {
    ScanInterval = 2,
    HopRetryDelay = 3,      -- Задержка между попытками хопа
    MaxServerPlayers = 8,
    TweenSpeed = 300,
    AntiAFK = true,
    AutoHop = true
}

local Enabled = true
local VisitedServers = {}
local IsHopping = false
local HopAttempts = 0

-- ============================================
-- ПОИСК ФРУКТОВ
-- ============================================
local function FindFruit()
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA("Tool") or v:IsA("Model") then
            local name = v.Name:lower()
            if name:find("fruit") or name:find("dragon") or name:find("dough") 
               or name:find("leopard") or name:find("kitsune") then
                return v
            end
        end
    end
    return nil
end

-- ============================================
-- ТЕЛЕПОРТ К ФРУКТУ
-- ============================================
local function TeleportToFruit(fruit)
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local fruitPart = fruit:FindFirstChildWhichIsA("BasePart")
    if not fruitPart and fruit:IsA("Tool") then
        fruitPart = fruit:FindFirstChild("Handle")
    end
    if not fruitPart then return false end
    
    local distance = (hrp.Position - fruitPart.Position).Magnitude
    
    if distance > 500 then
        hrp.CFrame = fruitPart.CFrame * CFrame.new(0, 5, 0)
    else
        local tweenInfo = TweenInfo.new(distance / Config.TweenSpeed, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = fruitPart.CFrame * CFrame.new(0, 5, 0)})
        tween:Play()
        tween.Completed:Wait()
    end
    
    wait(0.3)
    return true
end

-- ============================================
-- СБОР ФРУКТА
-- ============================================
local function CollectFruit(fruit)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, true, game:GetService("UserInputService").MouseIcon, 0)
    wait(0.1)
    VirtualInput:SendMouseButtonEvent(0, 0, 1, false, game:GetService("UserInputService").MouseIcon, 0)
    wait(0.2)
    VirtualInput:SendKeyEvent(true, "E", false, nil)
    wait(0.1)
    VirtualInput:SendKeyEvent(false, "E", false, nil)
    wait(0.3)
end

-- ============================================
-- ПОЛУЧЕНИЕ СПИСКА СЕРВЕРОВ
-- ============================================
local function GetServers()
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local success, response = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    
    if not success or not response or not response.data then
        return {}
    end
    
    local servers = {}
    for _, server in ipairs(response.data) do
        if server.id ~= game.JobId 
           and server.playing < Config.MaxServerPlayers 
           and server.playing > 0
           and not VisitedServers[server.id] then
            table.insert(servers, server)
        end
    end
    
    return servers
end

-- ============================================
-- БЕСКОНЕЧНЫЙ SERVER HOP
-- ============================================
local function InfiniteServerHop()
    if IsHopping then return end
    IsHopping = true
    
    HopAttempts = 0
    
    while Enabled do
        HopAttempts = HopAttempts + 1
        print("[SWILL] Попытка хопа #" .. HopAttempts)
        
        local servers = GetServers()
        
        -- Если не нашли серверов — сбрасываем список и пробуем снова
        if #servers == 0 then
            print("[SWILL] Нет серверов, сброс списка...")
            VisitedServers = {}
            wait(Config.HopRetryDelay)
            -- Продолжаем цикл, не выходим
        else
            -- Пробуем каждый сервер по очереди
            for _, server in ipairs(servers) do
                if not Enabled then
                    IsHopping = false
                    return
                end
                
                print("[SWILL] Пробуем сервер: " .. server.id .. " | Игроков: " .. server.playing)
                VisitedServers[server.id] = true
                
                -- Пытаемся телепортироваться
                local success = pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
                end)
                
                if not success then
                    print("[SWILL] Ошибка телепорта, пробуем следующий...")
                end
                
                -- Ждём. Если телепорт сработает — этот скрипт умрёт вместе с сервером.
                -- Если не сработает — продолжаем цикл.
                wait(Config.HopRetryDelay)
            end
        end
        
        -- Если дошли сюда — значит ни один сервер не сработал, повторяем
        print("[SWILL] Все сервера не сработали, повторяем...")
        wait(Config.HopRetryDelay)
    end
    
    IsHopping = false
end

